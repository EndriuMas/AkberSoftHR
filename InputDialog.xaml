<Window x:Class="AkberSoft.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="400" Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ФИО -->
        <TextBlock Text="ФИО:*" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="tbName" Grid.Row="0" Grid.Column="1" Margin="5" Height="30"/>

        <!-- Должность -->
        <TextBlock Text="Должность:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="tbPos" Grid.Row="1" Grid.Column="1" Margin="5" Height="30"/>

        <!-- Телефон -->
        <TextBlock Text="Телефон:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="tbPhone" Grid.Row="2" Grid.Column="1" Margin="5" Height="30"/>

        <!-- Email -->
        <TextBlock Text="Email:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="tbEmail" Grid.Row="3" Grid.Column="1" Margin="5" Height="30"/>

        <!-- Подсказка -->
        <TextBlock Text="* - обязательно для заполнения" Grid.Row="4" Grid.ColumnSpan="2" Margin="5" FontSize="10" Foreground="Gray"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,20,5,5">
            <Button Content="OK" Width="80" Height="35" Margin="5" Click="OkClick" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Cancel" Width="80" Height="35" Margin="5" Click="CancelClick" Background="#F44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
